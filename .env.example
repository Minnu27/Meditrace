DATABASE_URL=postgresql+psycopg://meditrace:meditrace-dev@localhost:5432/meditrace
OBJECT_STORE_PATH=./data/documents
MAX_UPLOAD_BYTES=20971520

# Required. Generate once per environment and never commit real values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left blank here, local dev auto-generates and persists throwaway values in
# .meditrace_dev_key (gitignored). Vercel/production MUST set both explicitly
# or the app refuses to start — see docs/SECURITY.md.
SECRET_KEY=
ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call this API cross-origin.
# Leave blank for same-origin only (the bundled web UI).
ALLOWED_ORIGINS=

# Optional OpenAI-compatible MedGemma/model gateway. Source text is never sent unless
# POST /api/documents/{id}/submit-to-model is called.
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_NAME=medgemma

# Optional: enables POST /api/documents/{id}/cxr-analyze once you've trained
# a checkpoint with notebooks/CXR_Sentinel_Full.ipynb. Requires the ml worker
# deployment (requirements-ml.txt); unset means the endpoint returns 503.
CXR_MODEL_PATH=

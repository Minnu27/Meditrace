# Copy to .env for local development. Never commit .env.
# Existing DATABASE_URL takes precedence over these individual settings.
#
# This matches `docker compose up -d mysql` (see docker-compose.yml), which
# publishes MySQL on 127.0.0.1:3308. MYSQL_USER=root here is fine ONLY on a
# throwaway local container that nothing else can reach. Before pointing
# this at a shared/cloud database, create a scoped app user instead — see
# docs/MYSQL_DEPLOYMENT.md.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=Meditrace
MYSQL_USER=root
MYSQL_PASSWORD=meditrace-dev-root
MYSQL_SSL=false
# For a hosted server: MYSQL_SSL=true; use its public hostname and port.
# MYSQL_SSL_CA=/absolute/path/to/provider-ca.pem
OBJECT_STORE_BACKEND=database
MAX_UPLOAD_BYTES=4000000

# Required. Generate once per environment and never commit real values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left blank here, local dev auto-generates and persists throwaway values in
# .meditrace_dev_key (gitignored). Vercel/production MUST set both explicitly
# or the app refuses to start — see docs/SECURITY.md.
SECRET_KEY=
ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call this API cross-origin.
# Leave blank for same-origin only (the bundled web UI).
ALLOWED_ORIGINS=

# Optional model gateway:
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_NAME=medgemma

# Optional: enables POST /api/documents/{id}/cxr-analyze once you've trained
# a checkpoint with notebooks/CXR_Sentinel_Full.ipynb. Requires the ml worker
# deployment (requirements-ml.txt); unset means the endpoint returns 503.
CXR_MODEL_PATH=

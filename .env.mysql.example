# Copy to .env for local development. Never commit .env.
# Existing DATABASE_URL takes precedence over these individual settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=Meditrace
MYSQL_USER=meditrace_app
MYSQL_PASSWORD=replace-locally
MYSQL_SSL=false
# For a hosted server: MYSQL_SSL=true; use its public hostname and port.
# MYSQL_SSL_CA=/absolute/path/to/provider-ca.pem
OBJECT_STORE_BACKEND=database
MAX_UPLOAD_BYTES=4000000
# Optional model gateway:
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_NAME=medgemma
